function FILTER_INTERNET_IMPORTS() {
    # Allow all Internet Routes to be imported from other PE routers
    if (ext_community has_any {ROUTE-TARGET-AS:65000:30000}) {
        return true;
    }
    # Allow all CGNAT VRF Prefixes to be imported.
    if (ext_community has_any {ROUTE-TARGET-AS:65000:50000}) {
        return true;
    }
    # Drop everything else
    return false;
}
